# All keys are optional. ChainWatch runs fully offline with the fake LLM and cached data.

# Local Ollama server (default model is set by CHAINWATCH_LLM_MODEL)
OLLAMA_HOST=http://localhost:11434

# Which LLM backend to use: fake | ollama | gemini | groq
CHAINWATCH_LLM_PROVIDER=fake
CHAINWATCH_LLM_MODEL=qwen2.5:3b

# Optional free-tier cloud fallbacks
GEMINI_API_KEY=
GROQ_API_KEY=
